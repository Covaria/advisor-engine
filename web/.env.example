# Copy to .env.local. None of these are secrets: they ship to the browser.
# API base URL (the FastAPI service). Local: uvicorn advisor_engine.api.main:app
VITE_API_URL=http://localhost:8000

# Supabase sign-in. The publishable key (sb_publishable_...) is safe in the browser;
# never put the secret key here.
VITE_SUPABASE_URL=https://znkwkvcnxtahwinrxbvn.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# Local development without Supabase: set a name and the app sends X-Dev-User instead
# of signing in. Only works against an API running with dev auth (no SUPABASE_URL).
# VITE_DEV_USER=alice
